{
  "name": "weir-agent",
  "version": "0.1.0",
  "description": "SDK and MCP server for agents using Weir: per-second token streams with a reviewer-panel dispute court on Robinhood Chain.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./deployment": {
      "types": "./dist/deployment.d.ts",
      "import": "./dist/deployment.js"
    }
  },
  "bin": {
    "weir-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build": "node scripts/sync.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "mcp": "tsx src/mcp.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "viem": "2.57.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
